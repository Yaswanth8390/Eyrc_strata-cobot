<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="realsense2_camera" params="name parent tf_prefix:='' *origin">

    <link name="${tf_prefix}${name}_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
        <geometry>
          <mesh filename="file://$(find ur_description)/meshes/realsense/d435i.glb"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1e-5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}${name}_joint" type="fixed">
      <parent link="${tf_prefix}${parent}"/>
      <child link="${tf_prefix}${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${tf_prefix}${name}_optical_frame">
      <inertial>
        <mass value="1e-5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-9" ixy="0.0" ixz="0.0" iyy="1e-9" iyz="0.0" izz="1e-9"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}${name}_optical_joint" type="fixed">
      <parent link="${tf_prefix}${name}_link"/>
      <child link="${tf_prefix}${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${tf_prefix}${name}_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${tf_prefix}${name}_optical_frame">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${tf_prefix}${name}_optical_frame">
      <sensor name="${name}_camera" type="rgbd_camera">
        <gz_frame_id>${tf_prefix}${name}_optical_frame</gz_frame_id>
        <camera name="${name}_camera">
          <horizontal_fov>1.2043</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>915.3003540039062</fx>
              <fy>914.0320434570312</fy>
              <cx>642.724365234375</cx>
              <cy>361.9780578613281</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>5</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>0</visualize>
        <topic>camera</topic>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
