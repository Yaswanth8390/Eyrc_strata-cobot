<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_description</name>
  <version>1.0.0</version>
  <description>
    UR7e description and Gazebo Harmonic simulation for the e-Yantra StrataCobot
    task. Modified by e-Yantra from the upstream Universal Robots ROS 2 description
    (https://github.com/UniversalRobots/Universal_Robots_ROS2_Description);
    upstream authorship is retained below.
  </description>

  <maintainer email="helpdesk@e-yantra.org">e-Yantra</maintainer>

  <license file="LICENSE">BSD-3-Clause</license>

  <url type="repository">https://github.com/UniversalRobots/Universal_Robots_ROS2_Description</url>

  <!-- Upstream authors, retained for attribution under BSD-3-Clause. -->
  <author>Nadia Hammoudeh Garcia</author>
  <author>Kelsey Hawkins</author>
  <author>G.A. vd. Hoorn</author>
  <author>Lovro Ivanov</author>
  <author>Mathias Ludtke</author>
  <author>Wim Meeussen</author>
  <author>Felix Messmer</author>
  <author>Miguel Prada Sarasola</author>
  <author>Denis Stogl</author>
  <author>Andy Zelenak</author>
  <author>Marvin Grosse Besselmann</author>
  <author email="schnell@fzi.de">Tristan Schnell</author>
  <author email="denis@stoglrobotics.de">Denis Stogl</author>
  <author email="dipentima@fzi.de">Vincenzo Di Pentima</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Linked by the prebuilt binaries in bin/ and lib/. Nothing here is compiled. -->
  <exec_depend>ament_index_cpp</exec_depend>
  <!-- rosdep KEYS, not apt package names. "assimp" is the key that resolves to the
       libassimp-dev package; "libassimp-dev" is not a key at all, and having it here
       made `rosdep install` over this workspace fail outright with "Cannot locate
       rosdep definition for [libassimp-dev]". That is the command every ROS tutorial
       tells you to run. "libfcl-dev" happens to be both a key and a package name. -->
  <exec_depend>assimp</exec_depend>
  <exec_depend>libfcl-dev</exec_depend>
  <!-- cartesian_servo links libcrypto.so.3: it seals its full diagnostics onto the
       hidden topic /_arm_detail rather than publishing all of them in the clear. The
       "openssl" key resolves to the apt package of the same name, which Depends on
       libssl3t64, so this does pull the runtime library in, indirectly.
       requirements.sh names libssl3t64 directly. -->
  <exec_depend>openssl</exec_depend>
  <exec_depend>kdl_parser</exec_depend>
  <exec_depend>orocos_kdl_vendor</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>

  <exec_depend>eyantra_kepler_colony</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
