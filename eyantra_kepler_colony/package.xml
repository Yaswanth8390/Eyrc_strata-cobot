<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eyantra_kepler_colony</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic simulation of the Kepler colony  arena: the SDF world plus
    its models and meshes, and a launch file that brings the world up on its own.
    Robots are spawned by separate launch files
  </description>
  <maintainer email="helpdesk@e-yantra.org">e-Yantra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
